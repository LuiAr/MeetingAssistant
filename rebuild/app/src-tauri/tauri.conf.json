{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeetingAssistant Rebuild",
  "version": "0.1.0",
  "identifier": "com.devswift.MeetingAssistant.rebuild",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MeetingAssistant Rebuild (Phase 1 spike)",
        "width": 780,
        "height": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
